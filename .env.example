# Copy to .env and export, or pass to docker. All values are optional.
MAX_UPLOAD_MB=500
MAX_DURATION_MIN=60
RETENTION_MINUTES=30
PROCESS_TIMEOUT_SEC=3600
CONCURRENT_JOBS=1
DEMUCS_MODEL=htdemucs        # or htdemucs_ft (slower, slightly better)
DEMUCS_DEVICE=auto           # auto | cpu | cuda
DEMUCS_SHIFTS=1
# DEMUCS_SEGMENT=7           # lower to reduce RAM/VRAM use
# ALLOWED_ORIGINS=http://localhost:5173
